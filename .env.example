# Gemma 4 via Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: open-weight models on Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Optional: on-demand images with FLUX.1-schnell — https://huggingface.co/settings/tokens
HF_TOKEN=
# DigitalOcean Serverless Inference (Gemma 4 31B in the cloud) — Control Panel → AI → Model access keys
DO_MODEL_ACCESS_KEY=
DO_MODEL=gemma-4-31B-it
